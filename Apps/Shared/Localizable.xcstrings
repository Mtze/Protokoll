    "settings.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zusammenfassung" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Summary" } }
      }
    },
    "settings.summary.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zusätzliche Anweisungen, die an den Standard-Prompt für die Zusammenfassung angehängt werden (z. B. Sprache, Tonfall, Länge, eigene Abschnitte). Struktur und Titel/Sprache-Kopf bleiben immer erhalten. Leer = Standard." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Extra instructions appended to the default summary prompt (e.g. language, tone, length, extra sections). The report structure and the title/language header are always kept. Empty = default." } }
      }
    },
    "settings.summary.reset" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Auf Standard zurücksetzen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Reset to default" } }
      }
    },
    "onboarding.welcome.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Willkommen bei Protokoll" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Welcome to Protokoll" } }
      }
    },
    "onboarding.welcome.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Alles bleibt lokal auf diesem Mac. Wir richten kurz die nötigen Berechtigungen ein - nur Mikrofon ist erforderlich. Protokoll braucht keinen Zugriff auf Fotos oder deine Ordner." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Everything stays local on this Mac. Let's set up the few permissions Protokoll needs - only the microphone is required. Protokoll never needs access to Photos or your folders." } }
      }
    },
    "onboarding.mic.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Mikrofon" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Microphone" } }
      }
    },
    "onboarding.mic.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Erforderlich, um Meetings aufzunehmen. Die Aufnahme bleibt auf diesem Gerät." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Required to record meetings. Recordings stay on this device." } }
      }
    },
    "onboarding.screen.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Bildschirmaufnahme" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Screen Recording" } }
      }
    },
    "onboarding.screen.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nur nötig, um den Systemton mitzuschneiden (z. B. die Gegenseite eines Anrufs). Kannst du überspringen und später aktivieren. Nach dem Erlauben ggf. App neu starten." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Only needed to capture system audio (e.g. the other side of a call). You can skip this and enable it later. You may need to restart the app after granting." } }
      }
    },
    "onboarding.notify.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Mitteilungen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Notifications" } }
      }
    },
    "onboarding.notify.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Optional: Protokoll meldet neue Aufnahmen (z. B. vom iPhone), die verarbeitet werden können." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Optional: Protokoll can tell you about new recordings (e.g. from your iPhone) that are ready to process." } }
      }
    },
    "onboarding.done.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Alles bereit" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You're all set" } }
      }
    },
    "onboarding.done.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Du kannst Berechtigungen jederzeit unter Diagnose anpassen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You can review permissions any time under Diagnostics." } }
      }
    },
