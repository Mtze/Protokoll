    "settings.transcription.preprocessing.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt tieffrequentes Rumpeln und korrigiert den Aufnahmepegel vor der Transkription. Eine Rauschunterdrückung wird absichtlich nicht angeboten: Sie verschlechtert die Genauigkeit großer Modelle messbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes low-frequency rumble and corrects the recording level before transcription. Noise reduction is deliberately not offered: it measurably worsens accuracy with large models."
          }
        }
      }
    },
