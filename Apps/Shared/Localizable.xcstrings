    "retranscribe.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme wird mit den aktuellen Einstellungen neu transkribiert, danach wird das Protokoll aus dem neuen Transkript erzeugt. Das dauert einige Minuten. Das bisherige Transkript und Protokoll bleiben als transcript.v1.md und protocol.v1.md erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording is transcribed from scratch with the current settings, and the protocol is then rebuilt from the new transcript. This takes a few minutes. The previous transcript and protocol are kept as transcript.v1.md and protocol.v1.md."
          }
        }
      }
    },
