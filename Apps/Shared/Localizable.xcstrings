    "delete.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme, Transkript und Protokoll dieser Sitzung werden gelöscht. Auf dem Mac wandert der Ordner in den Papierkorb."
