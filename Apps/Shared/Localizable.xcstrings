    "settings.summary.template.customized": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angepasst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customized"
          }
        }
      }
    },
    "settings.summary.template.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibt, was die Zusammenfassung enthalten soll. Die Vorgabe erzeugt einen chronologischen Verlauf des Meetings. Der Text kann vollständig umgeschrieben werden; Titel und Sprache des Meetings werden immer ermittelt, unabhängig vom Inhalt. Der Text ist auf Englisch, weil er die Aufgabe beschreibt - die Zusammenfassung entsteht weiterhin in der Sprache des Meetings."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describes what the summary should contain. The default produces a chronological account of the meeting. You can rewrite this completely; the meeting title and language are always extracted regardless of what you put here. The text is written in English because it describes the task - your summary is still written in the meeting's language."
          }
        }
      }
    },
    "settings.summary.template.recovery": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls eine Änderung die Zusammenfassungen verschlechtert: zurücksetzen und neu erzeugen. Frühere Fassungen bleiben als protocol.vN.md erhalten, das Transkript bleibt unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a change makes summaries worse, reset to default and regenerate. Earlier versions are kept as protocol.vN.md and the transcript is never affected."
          }
        }
      }
    },
    "settings.summary.template.reset": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Standard zurücksetzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset to default"
          }
        }
      }
    },
