    "consent.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording spoken words without consent can be a criminal offense (§ 201 StGB). Make sure everyone present agrees to be recorded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Aufnehmen des gesprochenen Wortes ohne Einwilligung kann strafbar sein (§ 201 StGB). Stelle sicher, dass alle Anwesenden der Aufnahme zustimmen."
          }
        }
      }
    },
