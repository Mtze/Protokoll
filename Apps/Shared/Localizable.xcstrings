    "settings.notifications.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zeigt eine Mitteilung (mit Aktion „Verarbeiten“), wenn eine neue Aufnahme erscheint - z. B. vom iPhone synchronisiert." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Show a notification (with a Process action) when a new recording appears - e.g. synced from your iPhone." } }
      }
