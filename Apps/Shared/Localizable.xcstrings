    "settings.voiceProcessing.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS-Echo-Unterdrückung für das Mikrofon verwenden. Aktivieren, wenn das Meeting über die Lautsprecher läuft, damit das Mikrofon die anderen Teilnehmenden nicht doppelt aufnimmt. Bei Kopfhörern ausgeschaltet lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use macOS echo cancellation on the microphone. Turn this on when the meeting plays through your speakers, so the microphone does not record the other participants a second time. Leave it off when you wear headphones."
          }
        }
      }
    },
